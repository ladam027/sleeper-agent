# Copy to .env and fill in. .env is gitignored; never commit secrets or paste them into chat.
ANTHROPIC_API_KEY=
# Long random string. Generate: openssl rand -hex 24
DASHBOARD_TOKEN=
# 127.0.0.1 keeps the dashboard private. Use Tailscale to reach it from your phone.
HOST=127.0.0.1
PORT=8787


# Phone (Build 2). See docs/builds/BUILD-2.md
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 format, e.g. +15551234567
TWILIO_FROM=
OWNER_PHONE=
# Tailscale Funnel URL for inbound texts (only port 8788 is exposed)
PUBLIC_URL=
HOOK_PORT=8788
