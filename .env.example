# Copy to .env and fill in. .env is gitignored; never commit secrets or paste them into chat.
ANTHROPIC_API_KEY=
# Long random string. Generate: openssl rand -hex 24
DASHBOARD_TOKEN=
# 127.0.0.1 keeps the dashboard private. Use Tailscale to reach it from your phone.
HOST=127.0.0.1
PORT=8787



# Phone (Build 2). Fill in yourself, never paste into chat. See docs/builds/BUILD-2.md
# Telegram: create a bot with @BotFather and paste its token
TELEGRAM_BOT_TOKEN=
# Telnyx calls: paste an API key, then run: npm run setup:telnyx (fills the next two lines)
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM=
# Your cell, E.164 format, e.g. +19515551234
OWNER_PHONE=
